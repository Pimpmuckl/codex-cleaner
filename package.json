{
  "name": "codex-cleaner",
  "version": "0.2.1",
  "description": "Simple cleanup for local Codex databases and archived history.",
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@11.15.0",
  "bin": {
    "codex-cleaner": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm run lint && npm run test && npm run build",
    "format": "prettier --check .",
    "lint": "eslint .",
    "prepack": "npm run build",
    "test": "node scripts/run-vitest.js"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.4.3",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "vitest": "^4.1.7"
  }
}
